# Backend scanner API base (SERVER-SIDE only — used by the BFF route handlers,
# never shipped to the browser). Required in production.
SCANNER_BACKEND_URL=http://localhost:3000/api/scanner

# Legacy fallback (public, inlined into the client bundle). The client no longer
# calls the backend directly, so prefer SCANNER_BACKEND_URL above and leave this
# unset. Kept only for backward compatibility.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/scanner
