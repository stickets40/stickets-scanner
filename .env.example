# Backend scanner API base (SERVER-SIDE only — used by the BFF route handlers,
# never shipped to the browser). Required in production.
SCANNER_BACKEND_URL=http://localhost:3000/api/scanner

# Shared secret the backend expects in X-Internal-Key (backend env INTERNAL_API_KEY).
# Lets the backend trust the forwarded client IP and skip the no-Origin guard.
INTERNAL_API_KEY=

# The scanner's own public origin, sent as the Origin header on every proxied
# call. Must be listed in the backend's ALLOWED_ORIGINS. Falls back to the
# request's forwarded host when unset.
SCANNER_PUBLIC_ORIGIN=http://localhost:3002

# Optional: pin the build id (defaults to VERCEL_GIT_COMMIT_SHA or a local stamp).
# SCANNER_BUILD_ID=

# Offline validation kill switch (default on). Set to 0 to force live-only mode.
# NEXT_PUBLIC_OFFLINE_VALIDATION=1

# Legacy fallback (public, inlined into the client bundle). Prefer
# SCANNER_BACKEND_URL above and leave this unset.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/scanner
